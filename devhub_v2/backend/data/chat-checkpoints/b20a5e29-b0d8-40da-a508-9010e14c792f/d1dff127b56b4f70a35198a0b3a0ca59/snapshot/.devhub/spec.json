{
  "product_name": "Omnia",
  "tagline": "Secure health-tech platform for doctor discovery, teleconsultations, and digital health records.",
  "tech_stack": {
    "frontend": "React 18 with Vite 4, React Router v6, Tailwind CSS, Axios",
    "backend": "FastAPI with SQLAlchemy + SQLite, Pydantic v2, Uvicorn",
    "notes": "Use Vite 4.x NOT 5.x on Windows. Use JSX not TSX. FastAPI routers use flat imports. SQLAlchemy sessions via Depends(get_db). Run `python seed.py` from inside backend/ dir."
  },
  "personas": [
    {
      "name": "Patient",
      "description": "Individuals seeking medical advice, looking to book appointments, consult online, and order medicines."
    },
    {
      "name": "Doctor",
      "description": "Medical professionals managing their appointments, conducting teleconsultations, and issuing e-prescriptions."
    }
  ],
  "pages": [
    {
      "route": "/",
      "name": "Home",
      "purpose": "Landing page with search functionality for doctors by specialty, symptoms, or name.",
      "components": [
        "Navbar",
        "HeroSearch",
        "SpecialtyGrid",
        "TopDoctorsCarousel",
        "Footer"
      ],
      "api_calls": [
        "GET /api/specialties",
        "GET /api/doctors/featured"
      ]
    },
    {
      "route": "/doctors",
      "name": "DoctorDirectory",
      "purpose": "List of doctors with filtering by specialty, availability, and consultation fee.",
      "components": [
        "Navbar",
        "FilterSidebar",
        "DoctorList",
        "DoctorCard",
        "Pagination"
      ],
      "api_calls": [
        "GET /api/doctors"
      ]
    },
    {
      "route": "/doctors/:id",
      "name": "DoctorProfile",
      "purpose": "Detailed view of a doctor's profile, reviews, and appointment booking interface.",
      "components": [
        "Navbar",
        "DoctorInfo",
        "ReviewList",
        "BookingCalendar",
        "TimeSlotPicker",
        "BookingModal"
      ],
      "api_calls": [
        "GET /api/doctors/{id}",
        "GET /api/doctors/{id}/slots",
        "POST /api/appointments"
      ]
    },
    {
      "route": "/dashboard",
      "name": "PatientDashboard",
      "purpose": "Central hub for patients to view upcoming appointments, past consultations, and health records.",
      "components": [
        "Navbar",
        "Sidebar",
        "UpcomingAppointments",
        "RecordList",
        "PrescriptionCard"
      ],
      "api_calls": [
        "GET /api/appointments",
        "GET /api/prescriptions"
      ]
    },
    {
      "route": "/consultation/:id",
      "name": "TeleconsultationRoom",
      "purpose": "Virtual room for video/chat consultation between doctor and patient.",
      "components": [
        "Navbar",
        "VideoPlayerPlaceholder",
        "ChatBox",
        "PatientVitalsSidebar",
        "EPrescriptionForm"
      ],
      "api_calls": [
        "GET /api/appointments/{id}",
        "POST /api/prescriptions"
      ]
    },
    {
      "route": "/medicines",
      "name": "Pharmacy",
      "purpose": "E-commerce section for ordering prescribed or over-the-counter medicines.",
      "components": [
        "Navbar",
        "MedicineSearch",
        "MedicineGrid",
        "MedicineCard",
        "CartDrawer",
        "CheckoutModal"
      ],
      "api_calls": [
        "GET /api/medicines",
        "POST /api/orders"
      ]
    }
  ],
  "data_models": [
    {
      "name": "User",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "notes": "primary key"
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "notes": "unique"
        },
        {
          "name": "password_hash",
          "type": "string",
          "required": true,
          "notes": ""
        },
        {
          "name": "full_name",
          "type": "string",
          "required": true,
          "notes": ""
        },
        {
          "name": "role",
          "type": "string",
          "required": true,
          "notes": "patient or doctor"
        },
        {
          "name": "phone",
          "type": "string",
          "required": false,
          "notes": ""
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "notes": ""
        }
      ],
      "description": "Core user account for both patients and doctors."
    },
    {
      "name": "Doctor",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "notes": "primary key"
        },
        {
          "name": "user_id",
          "type": "fk:User",
          "required": true,
          "notes": "links to User model"
        },
        {
          "name": "specialty",
          "type": "string",
          "required": true,
          "notes": "e.g., Cardiology, Dermatology"
        },
        {
          "name": "experience_years",
          "type": "integer",
          "required": true,
          "notes": ""
        },
        {
          "name": "consultation_fee",
          "type": "decimal",
          "required": true,
          "notes": ""
        },
        {
          "name": "bio",
          "type": "text",
          "required": false,
          "notes": ""
        },
        {
          "name": "image_url",
          "type": "string",
          "required": false,
          "notes": ""
        }
      ],
      "description": "Professional details for users with the doctor role."
    },
    {
      "name": "Appointment",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "notes": "primary key"
        },
        {
          "name": "patient_id",
          "type": "fk:User",
          "required": true,
          "notes": ""
        },
        {
          "name": "doctor_id",
          "type": "fk:Doctor",
          "required": true,
          "notes": ""
        },
        {
          "name": "appointment_date",
          "type": "datetime",
          "required": true,
          "notes": ""
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "notes": "scheduled, completed, cancelled"
        },
        {
          "name": "consultation_type",
          "type": "string",
          "required": true,
          "notes": "video, in-person"
        },
        {
          "name": "notes",
          "type": "text",
          "required": false,
          "notes": "patient symptoms"
        }
      ],
      "description": "Booking records between patients and doctors."
    },
    {
      "name": "Prescription",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "notes": "primary key"
        },
        {
          "name": "appointment_id",
          "type": "fk:Appointment",
          "required": true,
          "notes": ""
        },
        {
          "name": "doctor_id",
          "type": "fk:Doctor",
          "required": true,
          "notes": ""
        },
        {
          "name": "patient_id",
          "type": "fk:User",
          "required": true,
          "notes": ""
        },
        {
          "name": "medications",
          "type": "text",
          "required": true,
          "notes": "JSON string or formatted text of meds"
        },
        {
          "name": "instructions",
          "type": "text",
          "required": false,
          "notes": ""
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "notes": ""
        }
      ],
      "description": "Digital prescriptions issued after a consultation."
    },
    {
      "name": "Medicine",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "notes": "primary key"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "notes": ""
        },
        {
          "name": "description",
          "type": "text",
          "required": false,
          "notes": ""
        },
        {
          "name": "price",
          "type": "decimal",
          "required": true,
          "notes": ""
        },
        {
          "name": "requires_prescription",
          "type": "boolean",
          "required": true,
          "notes": ""
        },
        {
          "name": "stock",
          "type": "integer",
          "required": true,
          "notes": ""
        },
        {
          "name": "image_url",
          "type": "string",
          "required": false,
          "notes": ""
        }
      ],
      "description": "Inventory of medicines available for order."
    },
    {
      "name": "Order",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "notes": "primary key"
        },
        {
          "name": "patient_id",
          "type": "fk:User",
          "required": true,
          "notes": ""
        },
        {
          "name": "total_amount",
          "type": "decimal",
          "required": true,
          "notes": ""
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "notes": "pending, shipped, delivered"
        },
        {
          "name": "shipping_address",
          "type": "text",
          "required": true,
          "notes": ""
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "notes": ""
        }
      ],
      "description": "Medicine orders placed by patients."
    }
  ],
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/api/auth/login",
      "handler": "login_for_access_token",
      "purpose": "Authenticates user and returns JWT token",
      "auth_required": false,
      "request_body": {
        "username": "string (email)",
        "password": "string"
      },
      "response_shape": {
        "access_token": "string",
        "token_type": "string",
        "user": {
          "id": "integer",
          "role": "string"
        }
      }
    },
    {
      "method": "GET",
      "path": "/api/specialties",
      "handler": "get_specialties",
      "purpose": "Returns a list of unique doctor specialties for the home page",
      "auth_required": false,
      "request_body": {},
      "response_shape": [
        {
          "name": "string",
          "count": "integer"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/api/doctors",
      "handler": "list_doctors",
      "purpose": "Retrieves a list of doctors, optionally filtered by specialty",
      "auth_required": false,
      "request_body": {},
      "response_shape": [
        {
          "id": "integer",
          "full_name": "string",
          "specialty": "string",
          "consultation_fee": "decimal",
          "image_url": "string"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/api/doctors/{id}",
      "handler": "get_doctor_details",
      "purpose": "Retrieves full profile details for a specific doctor",
      "auth_required": false,
      "request_body": {},
      "response_shape": {
        "id": "integer",
        "full_name": "string",
        "specialty": "string",
        "bio": "string",
        "experience_years": "integer",
        "consultation_fee": "decimal"
      }
    },
    {
      "method": "GET",
      "path": "/api/doctors/{id}/slots",
      "handler": "get_doctor_slots",
      "purpose": "Retrieves available time slots for a doctor on a given date",
      "auth_required": false,
      "request_body": {},
      "response_shape": [
        {
          "datetime": "string",
          "is_available": "boolean"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/api/appointments",
      "handler": "create_appointment",
      "purpose": "Books a new appointment for the authenticated patient",
      "auth_required": true,
      "request_body": {
        "doctor_id": "integer",
        "appointment_date": "datetime",
        "consultation_type": "string",
        "notes": "string"
      },
      "response_shape": {
        "id": "integer",
        "status": "string",
        "appointment_date": "datetime"
      }
    },
    {
      "method": "GET",
      "path": "/api/appointments",
      "handler": "list_user_appointments",
      "purpose": "Retrieves all appointments for the logged-in user (patient or doctor)",
      "auth_required": true,
      "request_body": {},
      "response_shape": [
        {
          "id": "integer",
          "doctor_name": "string",
          "appointment_date": "datetime",
          "status": "string",
          "consultation_type": "string"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/api/prescriptions",
      "handler": "list_user_prescriptions",
      "purpose": "Retrieves all e-prescriptions for the logged-in patient",
      "auth_required": true,
      "request_body": {},
      "response_shape": [
        {
          "id": "integer",
          "doctor_name": "string",
          "medications": "string",
          "created_at": "datetime"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/api/prescriptions",
      "handler": "create_prescription",
      "purpose": "Allows a doctor to issue an e-prescription during/after a consultation",
      "auth_required": true,
      "request_body": {
        "appointment_id": "integer",
        "patient_id": "integer",
        "medications": "string",
        "instructions": "string"
      },
      "response_shape": {
        "id": "integer",
        "message": "string"
      }
    },
    {
      "method": "GET",
      "path": "/api/medicines",
      "handler": "list_medicines",
      "purpose": "Retrieves catalog of medicines for the pharmacy section",
      "auth_required": false,
      "request_body": {},
      "response_shape": [
        {
          "id": "integer",
          "name": "string",
          "price": "decimal",
          "requires_prescription": "boolean",
          "image_url": "string"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/api/orders",
      "handler": "create_order",
      "purpose": "Places a new medicine order for the patient",
      "auth_required": true,
      "request_body": {
        "items": [
          {
            "medicine_id": "integer",
            "quantity": "integer"
          }
        ],
        "shipping_address": "string"
      },
      "response_shape": {
        "id": "integer",
        "total_amount": "decimal",
        "status": "string"
      }
    }
  ],
  "auth_model": "jwt-token via FastAPI OAuth2PasswordBearer. Frontend stores token in localStorage and attaches to Axios Authorization header as 'Bearer <token>'.",
  "seed_data_description": "Seed script generates 50 Users (40 patients, 10 doctors). Doctors cover 5 specialties (Cardiology, Dermatology, General Practice, Pediatrics, Orthopedics) with realistic bios, fees ($50-$200), and picsum image URLs. Generates 100 Appointments (mix of past, upcoming, cancelled). Generates 40 Prescriptions linked to past appointments. Generates 50 Medicines (e.g., Paracetamol, Amoxicillin, Cetirizine) with realistic prices and stock levels. Generates 20 Orders linked to patients.",
  "key_user_flows": [
    "Flow 1: Patient visits Home \u2192 Searches for 'Dermatologist' \u2192 Views DoctorDirectory filtered by Dermatology \u2192 Clicks a DoctorCard \u2192 Views DoctorProfile \u2192 Selects a time slot \u2192 Books a video appointment.",
    "Flow 2: Patient logs in \u2192 Redirected to PatientDashboard \u2192 Sees upcoming video appointment \u2192 Clicks 'Join Call' \u2192 Enters TeleconsultationRoom \u2192 Consults with doctor \u2192 Receives e-prescription in dashboard.",
    "Flow 3: Patient visits Pharmacy (/medicines) \u2192 Browses medicines \u2192 Adds Paracetamol and Vitamin C to cart \u2192 Opens CartDrawer \u2192 Clicks Checkout \u2192 Enters shipping address \u2192 Places order."
  ],
  "_conventions_key": "React + Vite + FastAPI"
}